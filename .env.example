# Telegram Bot 与服务器端口配置文件 (.env)
# 存放在 Termux 根目录 ~/.env 或 dd/.env 均可

# 1. 网页服务器端口 (推荐 8080，适配 Cloudflare Tunnel 默认穿透)
PORT=8080

# 2. Telegram 机器人 ID
BOT_ID="7890123456"

# 3. Telegram 机器人 Token (向 @BotFather 创建并获取，注意带冒号)
BOT_TOKEN="7890123456:AAFdExampleTokenForChuDaDiBot"

# 4. Cloudflare Tunnel 隧道 Token (选填，在 Cloudflare Zero Trust 控制台创建)
# 如果配置了此 Token，Cloudflare Tunnel 将绑定你的固定自定义域名；若留空则自动启动免费临时域名穿透
CLOUDFLARE_TUNNEL_TOKEN=""

